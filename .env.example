# Copy to .env (never commit it) and fill ONE of the two blocks, or leave both empty for offline mode.

# --- OpenAI ---
# OPENAI_API_KEY=
# RAG_CHAT_MODEL=gpt-4.1-mini
# RAG_EMBED_MODEL=text-embedding-3-small

# --- Azure OpenAI (v1 API): models are your DEPLOYMENT names ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# RAG_CHAT_MODEL=<chat deployment>
# RAG_EMBED_MODEL=<embedding deployment>

# --- Optional ---
# RAG_RETRIEVER=tfidf            # force offline retrieval
# MCP_API_KEY=                   # require the x-api-key header on the MCP endpoint
# MCP_ALLOW_PRIVATE_TARGETS=1    # let check_endpoint reach private addresses (local testing only)
